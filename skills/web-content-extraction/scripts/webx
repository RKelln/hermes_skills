#!/usr/bin/env python3
"""webx — safe, smart web page to markdown extraction in one call.

Wraps the proven multi-step pipeline (tirith safety scan -> download ->
extraction -> validation) into a single CLI, so a research session is one
terminal call instead of four tool round trips.

Pipeline, in order:
  1. SAFETY   — tirith score <URL>; refuses high-risk URLs (--force overrides)
  2. DOWNLOAD — curl-cffi (Chrome TLS impersonation, beats bot detection),
                falls back to plain curl; never pipes network to a processor
  3. EXTRACT  — trafilatura (Python API, not the CLI's URL-list mode),
                then the publisher's own structured data (jsonld_extract.py:
                articleBody — restored WITH its headline — or a __NEXT_DATA__
                long-text field), then regex article/main/body fallback.
                The parsed JSON-LD graph is kept as well and reported in --json
                output as structured_types/structured_data, because for event and
                catalogue pages the useful payload is the nodes, not the prose.
  4. VALIDATE — drops consent pages and near-empty results; picks the longest
                credible candidate; PDF URLs go through pdftotext -layout

Exit codes: 0 = success (content on stdout), 1 = extraction failed,
2 = safety refusal, 3 = usage error.

Usage:
  webx <URL> [URL ...]                  markdown to stdout, metadata to stderr
  webx <URL> --out FILE.md              write content to file
  webx <URL> --json                     structured JSON on stdout
  webx --file urls.txt                  read one URL per line
  webx <URL> --keep                     keep downloaded HTML in /tmp/webx-*
  webx <URL> --force                    proceed even if tirith flags the URL
  webx <URL> --fallback-engine=crw      opt-in second engine when the page's content is
                                        not in the served HTML (unusable extraction, or a
                                        shell-like nav-only result). Rendered text is
                                        ATTACHED as content_rendered and the original kept;
                                        if nothing was usable at all, the rendered text
                                        becomes the content and method reads crw-js.
                                        A missing binary warns and is skipped — never an
                                        error. Set CRW_BIN if it is not on PATH. In --json
                                        output: fallback_status, fallback_reason,
                                        fallback_method, content_rendered, render_ms.

Metadata (URL, method used, char count, safety score) always goes to stderr,
so stdout stays clean markdown for the caller.
"""

import argparse
import html
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import textwrap
import time

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

TIRITH = os.path.join(os.path.expanduser("~"), ".hermes", "bin", "tirith")

# Structured data found while extracting, keyed by URL, surfaced in --json output as
# structured_types / structured_data / structured_truncated. Populated in process_url
# so the graph does not have to be threaded through every return path.
STRUCTURED_BY_URL = {}

# Failure/suspicion classification, keyed by URL, surfaced in --json output as
# failure_code / failure_remedy / render_candidate, plus extraction_suspect when the
# extraction "succeeded" but looks content-free. Machine-readable on purpose: an
# automatic fallback tier branches on these, and failure_hint() renders the same
# classification for humans, so the two can never drift apart.
FAILURE_BY_URL = {}

MOUNT_RE = re.compile(r'id=["\'](?:root|app|__next|___gatsby|__nuxt)["\']', re.I)
FRAMEWORK_MARKERS = ("__next_data__", "__nuxt__", "data-reactroot", "___gatsby", "sveltekit",
                     "thunderbolt", "wix-warmup", "wix-code", "ant-spin", "ant-layout",
                     "data-server-rendered")
CAPTCHA_MARKERS = ("recaptcha", "challenge-platform", 'id="challenge"', "cf-challenge",
                   "cf_chl_", "just a moment", "attention required")
SHELL_TEXT_MAX = 2500      # served-text ceiling for "this HTML holds almost nothing"
MIN_SENTENCES = 2          # below this in a short extraction, the text is fragments, not prose

# Opt-in second engine for pages whose content is not in the served HTML. Results are
# ATTACHED as content_rendered, never substituted for the original, because a render can
# be worse than the static text (a page can render to navigation) and the caller is the
# one who should choose. The reported method is always the one that actually produced the
# text in `content` — crw's own renderDecision field is not reliable under --js (it
# reports the auto-selection, not what executed), so we record our own facts instead.
FALLBACK_BY_URL = {}
FALLBACK_TIMEOUT = 180
CRW_BIN_ENV = "CRW_BIN"


def find_fallback_binary(engine):
    """Locate the fallback binary: $CRW_BIN, then PATH, then ~/.local/bin.

    No hard-coded private paths: webx ships publicly, so an unusual location is the
    caller's business to declare via the environment variable.
    """
    if engine != "crw":
        return None
    env = os.environ.get(CRW_BIN_ENV)
    if env and os.path.exists(env):
        return env
    found = shutil.which(engine)
    if found:
        return found
    guess = os.path.expanduser(f"~/.local/bin/{engine}")
    return guess if os.path.exists(guess) else None


def run_fallback(url, engine, reason):
    """Run the fallback engine. Returns (text_or_None, meta).

    Never raises and never changes the exit status by itself: a missing binary is a
    warning, because the caller already has a usable answer and a published script must
    not depend on a third-party binary being installed.
    """
    meta = {"fallback_engine": engine, "fallback_reason": reason or "extraction_failed"}
    binary = find_fallback_binary(engine)
    if not binary:
        meta["fallback_status"] = "not-installed"
        meta["fallback_hint"] = (f"{engine} not found — set {CRW_BIN_ENV} or put it on PATH; "
                                 "the extraction above stands unchanged")
        err(f"warning: fallback engine '{engine}' not installed — skipping "
            f"(set {CRW_BIN_ENV} or install it on PATH)")
        return None, meta

    cmd = [binary, "scrape", url, "--js", "--format", "json"]
    started = time.time()
    try:
        res = run(cmd, timeout=FALLBACK_TIMEOUT)
    except subprocess.TimeoutExpired:
        meta["fallback_status"] = "timeout"
        err(f"warning: fallback '{engine}' timed out after {FALLBACK_TIMEOUT}s")
        return None, meta
    meta["fallback_ms"] = int((time.time() - started) * 1000)
    if res.returncode != 0:
        meta["fallback_status"] = "error"
        err(f"warning: fallback '{engine}' exited {res.returncode} — ignoring its output")
        return None, meta
    try:
        data = json.loads(res.stdout)
    except (json.JSONDecodeError, TypeError):
        meta["fallback_status"] = "unparsable"
        return None, meta
    text = (data.get("markdown") or "").strip()
    if not text:
        meta["fallback_status"] = "empty"
        return None, meta
    md = data.get("metadata") or {}
    meta.update(fallback_status="used", fallback_method=f"{engine}-js",
                rendered_with=md.get("renderedWith"), render_ms=md.get("elapsedMs"),
                render_decision=data.get("renderDecision") or {})
    return text, meta
MIN_CREDIBLE_CHARS = 200          # below this an extraction is suspect
MIN_CONTENT_URL_CHARS = 500       # what a real article should roughly exceed
MAX_REGEX_BODY_CHARS = 100_000    # regex fallback hard cap
DOWNLOAD_TIMEOUT = 120            # seconds; uvx cold start can be slow
UVX_TOOL_TIMEOUT = 120

CONSENT_PATTERNS = (
    "consent",
    "accept all cookies",
    "cookie preferences",
    "your privacy choices",
    "one trust",
    "we value your privacy",
    "access denied",
    "not found",
    "404",
    "captcha",
    "sorry, you have been blocked",
)

# Boilerplate that can lead a candidate but is never the real article
JUNK_HEAD_PATTERNS = (
    "related posts",
    "share this",
    "sign up",
    "subscribe",
    "newsletter",
    "table of contents",
    "search results",
    "skip to content",
    "main menu",
    "privacy policy",
)

STOPWORDS = frozenset(
    "the a an and or of to in for on at by with is are was be it its how why what "
    "your you our from as that this may can not no".split()
)

# JSON-LD / __NEXT_DATA__ extraction lives in jsonld_extract.py beside this script.
# It used to be an embedded 53-line string constant; it is a file now because it is
# testable on its own (python3 jsonld_extract.py page.html) and it is the piece most
# likely to need fixing. realpath matters: webx is normally invoked through a symlink
# in ~/.local/bin, so __file__ alone would point at the wrong directory.
JSONLD_HELPER_PATH = os.path.join(
    os.path.dirname(os.path.realpath(__file__)), "jsonld_extract.py"
)


REGEX_EXTRACT_HELPER = textwrap.dedent(
    """
    import html, re, sys

    raw = open(sys.argv[1], encoding="utf-8", errors="replace").read()
    raw = re.sub(r"<script\\b.*?</script>", " ", raw, flags=re.DOTALL | re.IGNORECASE)
    raw = re.sub(r"<style\\b.*?</style>", " ", raw, flags=re.DOTALL | re.IGNORECASE)

    def extract(tag):
        m = re.search(r"<" + tag + r"\\b[^>]*>(.*?)</" + tag + r">", raw, flags=re.DOTALL | re.IGNORECASE)
        return m.group(1) if m else None

    for tag in ("article", "main"):
        body = extract(tag)
        if body:
            break
    else:
        m = re.search(r"<body\\b[^>]*>(.*?)</body>", raw, flags=re.DOTALL | re.IGNORECASE)
        body = m.group(1) if m else raw

    body = re.sub(r"<[^>]+>", "\\n", body)
    body = html.unescape(body)
    body = re.sub(r"[ \\t]+", " ", body)
    body = re.sub(r"\\n\\s*\\n+", "\\n\\n", body)
    print(body[:%d].strip())
    """
    % MAX_REGEX_BODY_CHARS
)


# ---------------------------------------------------------------------------
# Plumbing
# ---------------------------------------------------------------------------


def err(msg):
    print(f"[webx] {msg}", file=sys.stderr)


def run(cmd, timeout=DOWNLOAD_TIMEOUT, **kw):
    return subprocess.run(cmd, timeout=timeout, capture_output=True, text=True, **kw)


def safety_score(url, force=False):
    """Run tirith score. Returns (ok, score_str, detail) where ok=False means refuse."""
    if not os.path.exists(TIRITH):
        err("tirith not found at " + TIRITH + " — skipping safety scan")
        return True, "?", "tirith missing"
    try:
        res = run([TIRITH, "score", url], timeout=60)
    except subprocess.TimeoutExpired:
        err("tirith timed out — skipping safety scan")
        return True, "?", "timeout"
    out = (res.stdout or "") + (res.stderr or "")
    if "no issues found" in out:
        return True, "0/100", "clean"
    m = re.search(r"score:\s*(\d+)/100", out)
    score = int(m.group(1)) if m else 100
    if score >= 30:
        detail = out.strip().splitlines()[0][:300]
        return (force, f"{score}/100", detail)
    return True, f"{score}/100", out.strip().splitlines()[0][:300]


def download(url, dest):
    """Download to dest, no network pipes. Returns (byte_size, http_status).

    Plain curl first (gives us the HTTP status via -w). If the server
    bot-blocks plain curl (403/429) or returns an empty body, retry with
    curl-cffi (Chrome TLS impersonation). Real 4xx/5xx responses come back
    with the status so the caller can fail loudly instead of extracting a
    styled 404 page.
    """
    res = run(["curl", "-sL", "-w", "%{http_code}", "-o", dest, url])
    status = (res.stdout or "").strip()
    size = os.path.getsize(dest) if os.path.exists(dest) else 0
    if res.returncode != 0:
        return -1, status or None
    if status in ("403", "429") or (size <= 200 and status == "200") or has_challenge_markers(dest):
        try:
            res2 = run(["uvx", "curl-cffi", "get", url, "--impersonate", "chrome", "--body"])
            if res2.returncode == 0 and res2.stdout and len(res2.stdout.encode("utf-8", "replace")) > 200:
                with open(dest, "w", encoding="utf-8", errors="replace") as f:
                    f.write(res2.stdout)
                return len(res2.stdout.encode("utf-8", "replace")), "200"
        except FileNotFoundError:
            err("uvx not found; cannot retry with curl-cffi")
        except subprocess.TimeoutExpired:
            err("curl-cffi retry timed out")
    return (size, status) if size > 0 else (-1, status or None)


def extract_trafilatura(html_path):
    """Run trafilatura via uvx in a helper process. Returns text or None."""
    helper = os.path.join(os.path.dirname(html_path), "extract_trafilatura.py")
    with open(helper, "w", encoding="utf-8") as f:
        f.write(
            "import trafilatura, sys\n"
            "html = open(sys.argv[1], encoding='utf-8', errors='replace').read()\n"
            "print(trafilatura.extract(html, output_format='markdown') or '')\n"
        )
    try:
        res = run(
            ["uvx", "--from", "trafilatura", "python3", helper, html_path],
            timeout=UVX_TOOL_TIMEOUT,
        )
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    except FileNotFoundError:
        err("uvx not found; cannot run trafilatura")
    except subprocess.TimeoutExpired:
        err("trafilatura timed out")
    return None


_JSONLD_CACHE = {}


def jsonld_envelope(html_path):
    """Parsed ld+json envelope for a downloaded page: {text, title, types, blocks,
    truncated}. Cached per html_path, so reading the graph costs nothing when
    extract_html has already run the helper to get the text candidate.
    """
    if html_path in _JSONLD_CACHE:
        return _JSONLD_CACHE[html_path]
    env = None
    try:
        res = run([sys.executable, JSONLD_HELPER_PATH, html_path], timeout=60)
        if res.returncode == 0 and res.stdout.strip():
            try:
                parsed = json.loads(res.stdout)
                if isinstance(parsed, dict):
                    env = parsed
            except json.JSONDecodeError:
                # helper degraded to plain text; treat it as the old behaviour
                env = {"text": res.stdout.strip(), "types": [], "blocks": [],
                       "truncated": False}
    except subprocess.TimeoutExpired:
        err("json-ld scan timed out")
    _JSONLD_CACHE[html_path] = env
    return env


def extract_jsonld(html_path):
    """Publisher-declared content: headline + articleBody, or None.

    The helper returns the node's headline prepended to the body. Previously it
    returned the body alone, so whenever this candidate won the page title was
    silently dropped from the output.
    """
    env = jsonld_envelope(html_path)
    text = (env or {}).get("text") or ""
    return text.strip() or None


def extract_regex(html_path):
    """Regex article/main/body fallback, stdlib only. Returns text or None."""
    helper = os.path.join(os.path.dirname(html_path), "extract_regex.py")
    with open(helper, "w", encoding="utf-8") as f:
        f.write(REGEX_EXTRACT_HELPER)
    try:
        res = run([sys.executable, helper, html_path], timeout=60)
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    except subprocess.TimeoutExpired:
        err("regex extraction timed out")
    return None


def extract_pdf(pdf_path):
    try:
        res = run(["pdftotext", "-layout", pdf_path, "-"], timeout=60)
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    except FileNotFoundError:
        err("pdftotext not found")
    except subprocess.TimeoutExpired:
        err("pdftotext timed out")
    return None


FAILURE_HINTS = {
    "video": "video page — use the youtube-content skill / fetch_transcript.py for the transcript",
    "block_captcha": "anti-bot captcha wall (reCAPTCHA/Cloudflare challenge) — no crawler-friendly path; try web_search for a mirror or the site's API",
    "shell_csr": "JS-rendered page (Next.js CSR) — content is not in the static HTML; use the browser tool or find the content elsewhere (docs mirror, API, PDF)",
    "shell_mount": "empty JS app shell (mount point present, almost no text) — the content is injected by script; needs a renderer",
    "shell_spa": "JS app shell (framework markup, almost no text) — the content is injected by script; needs a renderer",
    "unknown": "try the browser tool or web_search for a mirror",
}

REMEDIES = {"video": "transcript", "block_captcha": "mirror", "shell_csr": "render",
            "shell_mount": "render", "shell_spa": "render", "unknown": "mirror"}


def served_text_len(raw):
    """Approximate text length of the served HTML (script/style removed)."""
    t = re.sub(r"<(script|style|noscript)\b.*?</\1>", " ", raw, flags=re.S | re.I)
    t = re.sub(r"<[^>]+>", " ", t)
    return len(re.sub(r"\s+", " ", t).strip())


def classify_failure(url, html_path):
    """(code, remedy) for a page that failed, or that extracted suspiciously little.

    The framework-name route is deliberately NOT the only signal: a Wix/NationBuilder
    events page carries no `__NEXT_DATA__`, no mount id and no framework marker at all --
    every browser-ish string in it belonged to the theme. What it does have is a served
    body that is almost entirely navigation. So the structural check (served text that is
    short AND fragment-like) is what catches that class.
    """
    if any(h in url.lower() for h in ("youtube.com", "youtu.be", "youtube-nocookie.com")):
        return "video", REMEDIES["video"]
    try:
        raw = open(html_path, encoding="utf-8", errors="replace").read(200_000)
    except OSError:
        return "unknown", REMEDIES["unknown"]
    low = raw.lower()
    if any(m in low for m in CAPTCHA_MARKERS):
        return "block_captcha", REMEDIES["block_captcha"]
    if "__next_data__" in low or 'id="__next"' in low:
        return "shell_csr", REMEDIES["shell_csr"]
    if served_text_len(raw) < SHELL_TEXT_MAX:
        if MOUNT_RE.search(raw):
            return "shell_mount", REMEDIES["shell_mount"]
        if any(m in low for m in FRAMEWORK_MARKERS):
            return "shell_spa", REMEDIES["shell_spa"]
    return "unknown", REMEDIES["unknown"]


def looks_content_free(text):
    """True when a 'successful' extraction is fragments rather than prose.

    Calibrated against two pages the bench separates cleanly: agntcy.org is
    legitimately thin (1,180 chars, 9 sentences -- a real, short landing page) while
    churchwellesleyvillage.ca/events returned 1,419 chars of pure menu with 0 sentences.
    Short-ness alone cannot tell those apart; absence of prose can. It is advisory
    (render_candidate), not an action, and a short factual page may trip it.
    """
    t = re.sub(r"\s+", " ", text or "").strip()
    if not t or len(t) >= SHELL_TEXT_MAX:
        return False
    return len(re.findall(r"[.!?]\s+[A-Z0-9]", t)) + len(re.findall(r"[.!?]$", t)) < MIN_SENTENCES


def failure_hint(url, html_path):
    """Targeted, human-readable reason when extraction finds nothing credible."""
    return FAILURE_HINTS[classify_failure(url, html_path)[0]]


def has_challenge_markers(path):
    """True if the downloaded body is an anti-bot challenge page."""
    try:
        raw = open(path, encoding="utf-8", errors="replace").read(200_000).lower()
    except OSError:
        return False
    return (
        "recaptcha" in raw
        or "challenge-platform" in raw
        or 'id="challenge"' in raw
        or "cf-browser-verification" in raw
    )


def looks_like_consent(text):
    head = text[:600].lower()
    return any(p in head for p in CONSENT_PATTERNS)


def page_title_words(html_path):
    """Extract og:title (or <title>), strip site-name suffixes, return
    significant words. Empty list if the page has no usable title."""
    try:
        raw = open(html_path, encoding="utf-8", errors="replace").read(100_000)
    except OSError:
        return []
    m = re.search(
        r'<meta[^>]+property=["\']og:title["\'][^>]+content=["\']([^"\']+)["\']',
        raw, re.IGNORECASE,
    )
    if not m:
        m = re.search(
            r'<meta[^>]+content=["\']([^"\']+)["\'][^>]+property=["\']og:title["\']',
            raw, re.IGNORECASE,
        )
    if not m:
        m = re.search(r"<title[^>]*>(.*?)</title>", raw, re.IGNORECASE | re.DOTALL)
    if not m:
        return []
    seg = re.split(r"\s+(\||\u2014|-)\s+", html.unescape(m.group(1)))[0]
    words = [
        w.lower() for w in re.findall(r"\w+", seg)
        if w.lower() not in STOPWORDS and len(w) > 2
    ]
    return words


def score_candidate(text, title_words, method):
    """Score how likely a candidate IS the real article, not just longest.

    Signals, in weight order:
    - title presence: does the candidate's opening contain the page's
      headline words? Real content almost always does; sidebars never do.
    - prose density: real articles have sentence periods; nav/sidebar
      fragments have few.
    - length on a soft curve: more text is usually better, but past a
      few thousand chars it stops being the deciding factor.
    - junk at the head: boilerplate leads (related posts, subscribe) are
      disqualifying signals.
    - extractor provenance: JSON-LD articleBody is publisher-declared full
      text; trafilatura is purpose-built boilerplate removal; regex is the
      last resort.
    """
    s = 0.0
    s += 2.0 * (len(text) / (len(text) + 8000))
    if title_words:
        head = re.sub(r"\s+", " ", text.lower())[:2000]
        found = sum(1 for w in title_words if w in head)
        s += 3.0 * found / len(title_words)
    periods = text.count(". ") / max(len(text) / 1000, 1)
    s += 0.8 * min(periods / 12.0, 1.0)
    hl = text[:300].lower()
    if any(j in hl for j in JUNK_HEAD_PATTERNS):
        s -= 1.5
    if method in ("json-ld", "trafilatura"):
        s += 0.5
    return s


def extract_html(html_path, url):
    """Try all extractors; return (best_text, method_used).

    Selection: score every credible candidate for how likely it is the real
    article (see score_candidate), pick the highest. Ties break toward
    trafilatura, then json-ld, then regex.
    """
    title_words = page_title_words(html_path)
    found = {}
    for method, fn in (
        ("trafilatura", extract_trafilatura),
        ("json-ld", extract_jsonld),
        ("regex", extract_regex),
    ):
        try:
            text = fn(html_path)
        except Exception as e:  # extraction must never crash the whole run
            err(f"{method} failed: {e}")
            text = None
        if text and len(text) >= MIN_CREDIBLE_CHARS and not looks_like_consent(text):
            found[method] = text

    if not found:
        return None, "none"

    order = {"trafilatura": 0, "json-ld": 1, "regex": 2}
    best_method = max(
        found,
        key=lambda m: (score_candidate(found[m], title_words, m), order[m]),
    )
    return found[best_method], best_method


def process_url(url, keep=False, force=False, fallback=""):
    if url.lower().endswith(".pdf") or "arxiv.org/pdf" in url.lower():
        return process_pdf(url, keep, force)
    ok, score, detail = safety_score(url, force=force)
    if not ok:
        err(f"SAFETY REFUSAL for {url} — tirith: {detail}")
        return 2
    err(f"safety: {score} — {url}")

    tmpdir = tempfile.mkdtemp(prefix="webx-")
    try:
        html_path = os.path.join(tmpdir, "page.html")
        size, status = download(url, html_path)
        if size <= 0:
            err(f"download failed for {url}" + (f" (HTTP {status})" if status else ""))
            return 1
        if status and status.startswith(("4", "5")):
            err(f"HTTP {status} for {url} — nothing to extract")
            return 1
        err(f"downloaded {size} bytes (HTTP {status or '?'})")

        text, method = extract_html(html_path, url)
        code, remedy = classify_failure(url, html_path)
        suspect = None
        if text is None:
            suspect = code
            FAILURE_BY_URL[url] = {"failure_code": code, "failure_remedy": remedy,
                                   "render_candidate": remedy == "render"}
            err(f"no credible extraction for {url} — {failure_hint(url, html_path)}")
        else:
            err(f"extracted {len(text)} chars via {method}")
            env = jsonld_envelope(html_path)
            if env and (env.get("types") or env.get("blocks")):
                STRUCTURED_BY_URL[url] = {
                    "structured_types": env.get("types") or [],
                    "structured_data": env.get("blocks") or [],
                    "structured_truncated": bool(env.get("truncated")),
                }
            # A successful extraction can still be content-free (nav-only shell). Flag it
            # rather than reporting success and letting the caller discover it downstream.
            if remedy == "render":
                suspect = code
                FAILURE_BY_URL[url] = {"failure_code": code, "failure_remedy": remedy,
                                       "render_candidate": True}
            elif looks_content_free(text):
                suspect = "prose_free"
                FAILURE_BY_URL[url] = {"extraction_suspect": "prose_free",
                                       "failure_remedy": "render", "render_candidate": True}

        # Opt-in second engine, only when the extraction was unusable or shell-like.
        # tirith already ran above, so the fallback inherits the safety gate rather than
        # bypassing it -- the reason to put it here and not in a caller's script.
        if fallback and (text is None or suspect is not None):
            rendered, meta = run_fallback(url, fallback, suspect)
            FALLBACK_BY_URL[url] = meta
            if rendered:
                if text is None:
                    text, method = rendered, meta.get("fallback_method", fallback)
                    err(f"fallback '{fallback}' recovered {len(rendered)} chars — using it "
                        f"(nothing else was usable)")
                else:
                    FALLBACK_BY_URL[url]["content_rendered"] = rendered
                    err(f"fallback '{fallback}' also produced {len(rendered)} chars — "
                        f"attached as content_rendered, original kept")
        if text is None:
            return 1
        return (text, method, score)
    finally:
        if not keep:
            shutil.rmtree(tmpdir, ignore_errors=True)


def process_pdf(url, keep=False, force=False):
    ok, score, detail = safety_score(url, force=force)
    if not ok:
        err(f"SAFETY REFUSAL for {url} — tirith: {detail}")
        return 2
    err(f"safety: {score} — {url} (pdf)")
    tmpdir = tempfile.mkdtemp(prefix="webx-")
    try:
        pdf_path = os.path.join(tmpdir, "paper.pdf")
        res = run(["curl", "-sL", "-w", "%{http_code}", "-o", pdf_path, url])
        status = (res.stdout or "").strip()
        size = os.path.getsize(pdf_path) if os.path.exists(pdf_path) else 0
        if res.returncode != 0 or size < 1000:
            err(f"pdf download failed for {url} (got {size} bytes, HTTP {status or '?'})")
            return 1
        if status and status.startswith(("4", "5")):
            err(f"HTTP {status} for {url} — nothing to extract")
            return 1
        text = extract_pdf(pdf_path)
        if not text or len(text) < 500:
            err(f"pdf text extraction too thin for {url}")
            return 1
        err(f"extracted {len(text)} chars from pdf")
        return (text, "pdftotext", score)
    finally:
        if not keep:
            shutil.rmtree(tmpdir, ignore_errors=True)


def selftest(tests_path=None):
    """Run the regression suite (webx-tests.tsv next to this script).

    Each line: URL<TAB>expect. Expect is ok:any:MINCHARS, ok:METHOD:MINCHARS,
    or fail. Prints one PASS/FAIL line per case to stderr, a summary to
    stdout, and exits 0 only if every case meets its expectation.
    """
    path = tests_path or os.path.join(os.path.dirname(os.path.realpath(__file__)), "webx-tests.tsv")
    cases = []
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if not line:
                    continue
                url, sep, expect = line.partition("\t")
                if sep and url and expect:
                    cases.append((url.strip(), expect.strip()))
    except OSError as e:
        err(f"cannot read test suite {path}: {e}")
        return 1
    if not cases:
        err("no test cases found in " + path)
        return 1

    passed = 0
    for url, expect in cases:
        outcome = process_url(url)
        if isinstance(outcome, tuple):
            text, method, _score = outcome
            if expect == "fail":
                err(f"FAIL  {url} — extracted {len(text)} chars via {method}, expected fail")
                continue
            parts = expect.split(":")
            method_want = parts[1] if len(parts) == 3 else "any"
            minchars = int(parts[2]) if len(parts) == 3 and parts[2].isdigit() else 0
            ok_method = method_want == "any" or method == method_want
            ok_chars = len(text) >= minchars
            if ok_method and ok_chars:
                err(f"pass  {url} — {method} {len(text)} chars")
                passed += 1
            else:
                err(f"FAIL  {url} — got {method} {len(text)} chars, expected {method_want} >= {minchars}")
        else:
            if expect == "fail":
                err(f"pass  {url} — failed gracefully as expected")
                passed += 1
            else:
                err(f"FAIL  {url} — extraction failed, expected {expect}")

    total = len(cases)
    print(f"webx selftest: {passed}/{total} passed")
    return 0 if passed == total else 1


def main():
    ap = argparse.ArgumentParser(description="Safe web page to markdown extraction")
    ap.add_argument("urls", nargs="*", help="URLs to extract")
    ap.add_argument("--file", dest="listfile", help="file with one URL per line")
    ap.add_argument("--out", help="write content to this file instead of stdout")
    ap.add_argument("--json", action="store_true", help="structured JSON output")
    ap.add_argument("--keep", action="store_true", help="keep downloaded HTML in /tmp")
    ap.add_argument("--force", action="store_true", help="proceed past tirith refusal")
    ap.add_argument("--fallback-engine", default="", choices=["", "crw"],
                    help="opt-in second engine for pages whose content is not in the served "
                         "HTML (runs only when extraction was unusable or shell-like; a "
                         "missing binary warns and is skipped, never fails the run)")
    ap.add_argument("--selftest", action="store_true", help="run the regression suite in webx-tests.tsv")
    args = ap.parse_args()

    if args.selftest:
        sys.exit(selftest())

    urls = list(args.urls)
    if args.listfile:
        with open(args.listfile, encoding="utf-8") as f:
            urls.extend(line.strip() for line in f if line.strip())
    urls = list(dict.fromkeys(urls))  # dedupe, preserve order
    if not urls:
        ap.error("no URLs given")

    results = []
    any_failed = False
    for url in urls:
        outcome = process_url(url, keep=args.keep, force=args.force,
                              fallback=args.fallback_engine)
        if isinstance(outcome, tuple):
            text, method, score = outcome
            rec = {"url": url, "method": method, "chars": len(text), "safety": score, "content": text}
            rec.update(STRUCTURED_BY_URL.get(url, {}))
            rec.update(FAILURE_BY_URL.get(url, {}))
            rec.update(FALLBACK_BY_URL.get(url, {}))
            results.append(rec)
        else:
            any_failed = True
            results.append({"url": url, "error": True, **FAILURE_BY_URL.get(url, {}),
                            **FALLBACK_BY_URL.get(url, {})})

    if args.json:
        print(json.dumps(results, ensure_ascii=False))
    else:
        chunks = []
        for r in results:
            if r.get("error"):
                continue  # failures are already reported on stderr
            head = f"**Source:** {r['url']}" if len(results) > 1 else f"Source: {r['url']}"
            chunks.append(f"{head}\n\n{r['content']}")
        joined = "\n\n---\n\n".join(chunks).strip() + ("\n" if chunks else "")
        if args.out:
            if chunks:
                with open(args.out, "w", encoding="utf-8") as f:
                    f.write(joined)
                err(f"wrote {len(joined)} chars to {args.out}")
            else:
                err("nothing to write — all URLs failed")
        elif chunks:
            print(joined)
        # else: silent stdout, errors already on stderr

    sys.exit(1 if any_failed else 0)


if __name__ == "__main__":
    main()
